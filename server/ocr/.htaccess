# The text recogniser for «Семейная книга»: big files that never change — cached for long.
# The language file is gzip data the recogniser unpacks itself, so the server must not mark it as compressed.
<IfModule mod_mime.c>
  RemoveEncoding .gz
  AddType application/octet-stream .gz
</IfModule>
<IfModule mod_headers.c>
  Header set Cache-Control "public, max-age=31536000, immutable"
</IfModule>
